#!/bin/sh
# Ponto de entrada do AppImage.
#   ./GameSir_Bridge.AppImage            abre o app (ou, sem interface, instala e mostra o estado)
#   ./GameSir_Bridge.AppImage <comando>  qualquer comando do gamesir-bridge (setup, status, calibrate...)
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="${APPDIR:-$HERE}"
BIN="$APPDIR/usr/bin"

if [ $# -gt 0 ]; then
    exec "$BIN/gamesir-bridge" "$@"
fi

run_app() {
    LIB="$APPDIR/usr/lib"
    export LD_LIBRARY_PATH="$LIB${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
    export GIO_MODULE_DIR="$LIB/gio/modules"
    CACHE_IN="$LIB/gdk-pixbuf-2.0/2.10.0/loaders.cache.in"
    if [ -f "$CACHE_IN" ]; then
        CACHE="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/gamesir-bridge-pixbuf-$(id -u).cache"
        sed "s|@APPDIR@|$APPDIR|g" "$CACHE_IN" >"$CACHE" && export GDK_PIXBUF_MODULE_FILE="$CACHE"
    fi
    exec "$BIN/gamesir-bridge-app"
}

# O app precisa de uma glibc recente (2.39+). Se não abrir aqui, cai para a linha de comando.
if [ -x "$BIN/gamesir-bridge-app" ] &&
    LD_LIBRARY_PATH="$APPDIR/usr/lib" "$BIN/gamesir-bridge-app" --version >/dev/null 2>&1; then
    run_app
fi
if [ -x "$BIN/gamesir-bridge-app" ]; then
    echo "A interface não abriu neste sistema (precisa de glibc 2.39 ou mais nova)." >&2
    echo "Seguindo pela linha de comando." >&2
fi
"$BIN/gamesir-bridge" setup --if-needed || exit $?
exec "$BIN/gamesir-bridge" status
